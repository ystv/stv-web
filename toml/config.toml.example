# Example config.toml

[server]
    debug = false # boolean
    port = "" # e.g. ":80"
    domain_name = "" # domain name
    force_reset_url_endpoint = "" # the url endpoint to forcefully reset all stored information

[keycloak]
    keycloak_url 		= "http://localhost/"
    keycloak_realm 		= "realm"
    keycloak_clientID		= "stv-web"
    keycloak_secret 		= "client_secret"
    keycloak_redirectURL	= ""

[mail]
    mail_host = "" # Mail server
    mail_username = "" # Mail username
    mail_password = "" # Mail password
    mail_port = -1 # Mail port
    mail_defailt_to = ""
